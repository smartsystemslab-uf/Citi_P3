{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citi-p3.example/zero-trust/task5-interface-extension.schema.json",
  "title": "Zero Trust Backplane Task 5 Interface Extension",
  "type": "object",
  "required": ["interface_version", "request", "pep"],
  "properties": {
    "interface_version": {"const": "1.0"},
    "request": {
      "type": "object",
      "required": ["subject", "resource", "action", "parameters", "workflow_id", "audience", "endpoint"],
      "properties": {
        "request_id": {"type": "string"},
        "subject": {"type": "string", "minLength": 1},
        "resource": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "workflow_id": {"type": "string"},
        "audience": {"type": "string"},
        "endpoint": {"type": "string"},
        "critical": {"type": "boolean"},
        "idempotency_key": {"type": ["string", "null"]},
        "evidence": {"type": "object"}
      },
      "additionalProperties": true
    },
    "pep": {
      "type": "object",
      "required": ["pep_id", "pep_identity", "pep_key_thumbprint"],
      "properties": {
        "pep_id": {"type": "string"},
        "pep_identity": {"type": "string"},
        "pep_key_thumbprint": {"type": "string", "pattern": "^sha256:"}
      },
      "additionalProperties": true
    },
    "task4_decision": {
      "type": "object",
      "required": ["decision", "request_hash", "policy_version", "identity_version", "risk_version", "decision_key_id"],
      "properties": {
        "decision": {"enum": ["ALLOW", "DENY", "MANUAL_REVIEW", "ALLOW_WITH_OBLIGATIONS", "REAUTHENTICATE"]},
        "request_hash": {"type": "string", "pattern": "^sha256:"},
        "policy_version": {"type": "string"},
        "identity_version": {"type": "string"},
        "risk_version": {"type": "string"},
        "decision_key_id": {"type": "string"}
      },
      "additionalProperties": true
    },
    "permit_lease": {
      "type": "object",
      "required": ["permit_id", "request_hash", "expires_at", "policy_version", "max_uses", "pep_key_thumbprint", "signature"],
      "properties": {
        "permit_id": {"type": "string"},
        "request_hash": {"type": "string", "pattern": "^sha256:"},
        "expires_at": {"type": "string", "format": "date-time"},
        "policy_version": {"type": "string"},
        "identity_version": {"type": "string"},
        "risk_version": {"type": "string"},
        "max_uses": {"type": "integer", "minimum": 1},
        "pep_key_thumbprint": {"type": "string", "pattern": "^sha256:"},
        "signature": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
